generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [postgis, vector, pgcrypto]
}

// 1. oauth_vault
model OAuthVault {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  provider        String
  accessTokenEnc  Bytes     @map("access_token_enc")
  refreshTokenEnc Bytes?    @map("refresh_token_enc")
  expiresAt       DateTime? @map("expires_at") @db.Timestamptz
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([userId, provider], map: "uq_oauth_vault_user_provider")
  @@map("oauth_vault")
}

// 2. daily_biometrics (Autoridad unica: Garmin)
model DailyBiometric {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  date         DateTime @db.Date
  source       String   @default("garmin")
  activeKcal   Int      @default(0) @map("active_kcal")
  restingKcal  Int      @default(0) @map("resting_kcal")
  sleepMinutes Int      @default(0) @map("sleep_minutes")
  hrvMs        Decimal? @map("hrv_ms") @db.Decimal(6, 2)
  restingHr    Int?     @map("resting_hr")
  rawPayload   Json     @default("{}") @map("raw_payload") @db.JsonB
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([userId, date], map: "uq_daily_biometrics_user_date")
  @@index([userId, date(sort: Desc)], map: "idx_daily_biometrics_user_date")
  @@map("daily_biometrics")
}

// 3. body_composition (Autoridad: RENPHO -> Garmin)
model BodyComposition {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  measuredAt     DateTime @map("measured_at") @db.Timestamptz
  source         String
  weightKg       Decimal  @map("weight_kg") @db.Decimal(5, 2)
  bodyFatPct     Decimal? @map("body_fat_pct") @db.Decimal(5, 2)
  muscleMassKg   Decimal? @map("muscle_mass_kg") @db.Decimal(5, 2)
  syncedToGarmin Boolean  @default(false) @map("synced_to_garmin")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@unique([userId, measuredAt, source], map: "uq_body_composition_user_ts_source")
  @@index([userId, measuredAt(sort: Desc)], map: "idx_body_composition_user_measured")
  @@map("body_composition")
}

// 4. strength (catalog / sessions / sets con garmin_step_note)
model StrengthCatalog {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String?       @map("user_id") @db.Uuid
  externalId  String        @map("external_id")
  name        String
  muscleGroup String?       @map("muscle_group")
  equipment   String?
  isPublic    Boolean       @default(false) @map("is_public")
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz
  sets        StrengthSet[]

  @@unique([userId, externalId], map: "uq_strength_catalog_user_ext")
  @@map("strength_catalog")
}

model StrengthSession {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String        @map("user_id") @db.Uuid
  externalId    String        @map("external_id")
  source        String
  startedAt     DateTime      @map("started_at") @db.Timestamptz
  endedAt       DateTime?     @map("ended_at") @db.Timestamptz
  totalVolumeKg Decimal       @default(0) @map("total_volume_kg") @db.Decimal(10, 2)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz
  sets          StrengthSet[]

  @@unique([userId, externalId], map: "uq_strength_sessions_user_ext")
  @@index([userId, startedAt(sort: Desc)], map: "idx_strength_sessions_user_started")
  @@map("strength_sessions")
}

model StrengthSet {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId      String          @map("session_id") @db.Uuid
  exerciseId     String          @map("exercise_id") @db.Uuid
  setIndex       Int             @map("set_index")
  weightKg       Decimal         @default(0) @map("weight_kg") @db.Decimal(6, 2)
  reps           Int
  rpe            Decimal?        @db.Decimal(3, 1)
  garminStepNote String?         @map("garmin_step_note")
  session        StrengthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exercise       StrengthCatalog @relation(fields: [exerciseId], references: [id], onDelete: Restrict)

  @@unique([sessionId, exerciseId, setIndex], map: "uq_strength_sets_session_ex_idx")
  @@map("strength_sets")
}

// 5. gpx_routes (LineStringZ + GIST + GAP)
model GpxRoute {
  id             String                                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String                                @map("user_id") @db.Uuid
  externalId     String                                @map("external_id")
  source         String
  geom           Unsupported("geometry(LineStringZ, 4326)")
  distanceM      Decimal                               @map("distance_m") @db.Decimal(10, 2)
  elevationGainM Decimal                               @default(0) @map("elevation_gain_m") @db.Decimal(8, 2)
  gapPaceSecKm   Decimal?                              @map("gap_pace_sec_km") @db.Decimal(7, 2)
  startedAt      DateTime                              @map("started_at") @db.Timestamptz
  createdAt      DateTime                              @default(now()) @map("created_at") @db.Timestamptz

  @@unique([userId, externalId], map: "uq_gpx_routes_user_ext")
  @@index([geom], type: Gist, map: "idx_gpx_routes_geom_gist")
  @@index([userId, startedAt(sort: Desc)], map: "idx_gpx_routes_user_started")
  @@map("gpx_routes")
}

// 6. nutrition_logs (portion_templates + vector 768 + HNSW gestionado en SQL)
model NutritionLog {
  id               String                        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String                        @map("user_id") @db.Uuid
  loggedAt         DateTime                      @map("logged_at") @db.Timestamptz
  mealSlot         String                        @map("meal_slot")
  foodName         String                        @map("food_name")
  portionTemplates Json                          @default("[]") @map("portion_templates") @db.JsonB
  kcal             Decimal                       @db.Decimal(7, 2)
  proteinG         Decimal                       @default(0) @map("protein_g") @db.Decimal(6, 2)
  carbsG           Decimal                       @default(0) @map("carbs_g") @db.Decimal(6, 2)
  fatG             Decimal                       @default(0) @map("fat_g") @db.Decimal(6, 2)
  embedding        Unsupported("vector(768)")?
  source           String                        @default("pulsetrack")
  createdAt        DateTime                      @default(now()) @map("created_at") @db.Timestamptz

  @@unique([userId, loggedAt, foodName, mealSlot], map: "uq_nutrition_logs_user_ts_food_slot")
  @@index([userId, loggedAt(sort: Desc)], map: "idx_nutrition_logs_user_logged")
  @@map("nutrition_logs")
}

// 7. ai_predictions (shap_breakdown JSONB + ACWR)
model AiPrediction {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  targetDate     DateTime @map("target_date") @db.Date
  modelVersion   String   @map("model_version")
  readinessScore Decimal  @map("readiness_score") @db.Decimal(5, 2)
  acwr           Decimal  @db.Decimal(5, 3)
  shapBreakdown  Json     @default("{}") @map("shap_breakdown") @db.JsonB
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@unique([userId, targetDate, modelVersion], map: "uq_ai_predictions_user_date_model")
  @@index([userId, targetDate(sort: Desc)], map: "idx_ai_predictions_user_date")
  @@map("ai_predictions")
}

// 8. ai_telemetry_logs
model AiTelemetryLog {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  requestId String   @unique(map: "uq_ai_telemetry_logs_request") @map("request_id") @db.Uuid
  provider  String
  modelName String   @map("model_name")
  latencyMs Int      @map("latency_ms")
  tokensIn  Int      @default(0) @map("tokens_in")
  tokensOut Int      @default(0) @map("tokens_out")
  status    String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([userId, createdAt(sort: Desc)], map: "idx_ai_telemetry_logs_user_created")
  @@map("ai_telemetry_logs")
}
